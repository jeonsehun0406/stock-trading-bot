# ═══════════════════════════════════════════════════════════
#  자동매매 봇 환경설정  → 이 파일을 ".env" 로 이름 변경 후 값 입력
#  ⚠️ .env 는 절대 GitHub 등에 올리지 마세요! (.gitignore에 포함됨)
# ═══════════════════════════════════════════════════════════

# ── 한국투자증권 KIS API ──
# apiportal.koreainvestment.com 에서 발급
# 실전과 모의투자는 앱키가 각각 따로 발급됩니다.

KIS_HTS_ID=your_hts_id
KIS_ACCOUNT_NO=12345678-01

# 실전투자용 앱키/시크릿
KIS_APP_KEY=실전_앱키
KIS_APP_SECRET=실전_시크릿

# 모의투자용 앱키/시크릿 (모의투자 도메인에서 별도 발급)
KIS_V_APP_KEY=모의_앱키
KIS_V_APP_SECRET=모의_시크릿
# ⚠️ 모의투자 계좌번호는 위 KIS_ACCOUNT_NO(실전)와 다릅니다 — 모의투자 신청 화면에서 확인
KIS_V_ACCOUNT_NO=87654321-01

# 모의투자 여부:
#   true  = 모의투자 (가짜 돈, 안전) ← 처음엔 반드시 true
#   false = 실전투자 (진짜 돈!)      ← 충분히 검증한 뒤에만
KIS_VIRTUAL=true

# ── 텔레그램 알림 (notifier.py) ──
TELEGRAM_BOT_TOKEN=봇토큰
TELEGRAM_CHAT_ID=chat_id

# ── 카카오톡 알림 (선택) ──
KAKAO_REST_API_KEY=카카오_REST_API_키

# ── 뉴스 감성분석 필터 (news_filter.py, 선택) ──
# console.anthropic.com 에서 발급
# 없어도 봇은 정상 동작합니다 (fail-open — 필터를 그냥 건너뜁니다)
ANTHROPIC_API_KEY=여기에_Anthropic_API_키

# ── 매매 전략 선택 (strategies.py, 선택) ──
# 5개 중 하나 입력. 없으면 기본값 rsi로 동작합니다.
#   rsi        = RSI 과매도 저가매수 (횡보,눌림목). 위험회피형. ← 기본값
#   ma_cross   = 이동평균 골든크로스 (단기선이 장기선 상향 돌파). 상승추세 진입.
#   bollinger  = 볼린저밴드 하단 이탈 후 반등. 변동성 횡보장.
#   breakout   = N일 신고가 돌파(강한 상승 시작). 공격적, 추세 초입 포착.
#   macd       = MACD 골든크로스(추세 전환점). 중립.
# 어떤 전략이 좋은지는 compare_strategies.py로 먼저 데이터를 보고 정하세요.
BOT_STRATEGY=rsi

# ── 미국 주식 거래 활성화 (선택) ──
#   false (기본값) = 한국 주식만 매매 (기존과 100% 동일)
#   true            = universe.json의 "us" 목록(대형주)도 함께 스캔·매매
# ⚠️ python-kis에는 원화→달러 자동환전 기능이 없습니다.
#    이 값을 true로 켜기 전에 반드시 KIS 앱(또는 홈페이지)에서 원화를 달러로
#    미리 환전해두세요. 환전을 안 해두면 true로 켜도 USD 예수금이 0원이라
#    미국 매수가 전혀 되지 않고 조용히 스킵됩니다(로그에 사유가 남습니다).
#    한국 주식 매매·기존 안전장치에는 어떤 영향도 없습니다.
ENABLE_US_TRADING=false

# ── 켈리 포지션 사이징 (선택, 없으면 아래 기본값 사용) ──
# 최근 매도 30건의 실현손익으로 승률·손익비를 계산해 매수 예산 비중을 정합니다.
# 거래 이력이 5건 미만이면 자동으로 균등분배(1/최대보유종목수)로 시작합니다.
KELLY_FRACTION=0.25    # 1/4 켈리 (풀켈리는 과격해서 위험 — 0.25 권장)
KELLY_MAX_WEIGHT=0.25  # 한 종목 최대 비중 25% (분산 강제)
KELLY_MIN_WEIGHT=0.05  # 한 종목 최소 비중 5%

# ── 장후시간외(종가) 매수 (선택) ──
#   false (기본값) = 기존과 동일하게 일반 지정가/시장가로 매수
#   true            = KIS 공식 "장후시간외" 주문조건으로 매수 — 정규장 마감 후
#                     15:40~16:00 KST에 그날 종가로 체결됨 (한국 종목 전용)
# ⚠️ 이 주문조건은 python-kis 라이브러리 단계에서부터 모의투자를 거부합니다
#    ("모의투자는 해당 주문조건을 지원하지 않습니다") — KIS_VIRTUAL=false(실전투자)로
#    전환하기 전까지는 이 값을 true로 켜도 항상 스킵되며 검증이 불가능합니다.
#    실전 전환 후 반드시 소액으로 먼저 확인하세요. 켤 경우 15:40~16:00 KST에도 봇이
#    실행되도록 스케줄러 트리거를 추가해야 합니다 (서버_무인실행_가이드.md 참고).
ENABLE_CLOSING_TRADE=false
